{
  "name": "corsarr-desktop-frontend",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "vite",
    "test": "node --test src/*.test.ts src/**/*.test.ts",
    "build": "tsc && vite build",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "quality": "biome check . && tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "typescript": "^5.6.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "i18next": "26.3.6"
  }
}
