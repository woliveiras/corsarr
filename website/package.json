{
  "name": "corsarr-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "quality": "biome check . && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "wrangler": "4.115.0"
  }
}
