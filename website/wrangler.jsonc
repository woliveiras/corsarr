{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "corsarr-site",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false
  }
}
